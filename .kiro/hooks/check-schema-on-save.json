{
  "version": "v1",
  "hooks": [
    {
      "name": "Check scenario schema on save",
      "trigger": "PostFileSave",
      "matcher": "(^|[\\\\/])apps[\\\\/][^\\\\/]+[\\\\/]scenarios[\\\\/].+\\.json$",
      "action": {
        "type": "command",
        "command": "node scripts/sensors/hook-dispatch.ts schema"
      }
    }
  ]
}